# 빌드 컨텍스트에 넣지 않을 것. 이미지가 커지거나 비밀이 들어가는 것을 막는다.

# 모델 가중치. 기본 빌드는 호스팅 모델을 쓰므로 넣지 않는다.
# --build-arg WITH_LOCAL_MODEL=1 로 빌드하면 Dockerfile 이 HF 에서 받는다.
backend/app/models/*.gguf
backend/app/models/*.gguf.*
backend/app/models/.cache/

# 작업 중 만든 사본
*.bak
*.premerge.bak

# 비밀
.env
.env.*
!.env.example

# 저장소·캐시·생성물
.git
.gitignore
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
frontend/
evals/results/
docs/
finetune/
*.log
