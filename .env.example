# 실제 값은 .env에만 적으세요 (커밋 금지). 이 파일은 필요한 키 목록만 공유하는 용도입니다.

# ── LLM ─────────────────────────────────────────────
# OpenRouter 권장: 키 하나로 여러 회사 모델을 같은 코드로 부를 수 있어
# 축 ②가 요구하는 "2개 이상 모델 비교"가 쉬워집니다.
# OPENROUTER_API_KEY=<...>
# 직접 호출을 쓴다면
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# MODEL_SMALL_PATH=backend/app/models/kanana_2.1b-Q4_K_M.gguf   # HF kimseunguk/converge-slot-extractor (공개)
# MODEL_SMALL=anthropic-ai/claude-haiku-5-5   # 10-31: 슬롯 추출은 Claude API (ANTHROPIC_API_KEY 필요). 로컬 GGUF 는 쓰지 않는다
#                               google-ai/gemini-2.5-flash-lite  구글 직접 (무료 할당)
#                               google/gemini-3.1-flash-lite     OpenRouter (유료)
# GEMINI_API_KEY=<...>          # aistudio.google.com/apikey. MODEL_* 가 google-ai/ 일 때만 쓴다
# MODEL_LARGE=openai/gpt-4o-mini
# MODEL_VISION=openai/gpt-4o-mini   # 캡처 읽기. 비우면 MODEL_LARGE 가 읽는다
# LLM_TIMEOUT_SEC=30           # LLM 호출 하나의 상한(초). 넘으면 재시도·대형으로 넘긴다
# COST_LIMIT_USD_PER_REQUEST=0.05
# DAILY_COST_LIMIT_USD=1.0        # 하루 합계 상한. 비우면 제한 없음 (41번)

# ── 외부 API ────────────────────────────────────────
# KAKAO_REST_KEY=<...>
# TMAP_APP_KEY=<...>
# DATA_GO_KR_KEY=<...>          # 부산 도시철도 첫차·막차 (공공데이터포털)
# SEOUL_OPENDATA_KEY=<...>      # 서울 지하철 첫차·막차 (서울 열린데이터광장, data.go.kr 과 다른 사이트)
# TYPESAFE_API_KEY=<...>        # 출입 절차 판단 모델(Jev). 규칙으로 못 가르는 문장에서만 부른다 (access.md 5순위)
# JEV_ACCESS=0                  # 1 이면 켠다. 키가 없으면 켜도 부르지 않는다
# JEV_PROVIDER=typesafe         # typesafe(TYPESAFE_API_KEY) 또는 cloudflare(아래 두 값). 모델은 같다
#   Vercel AI Gateway 로 부를 때 (TypeSafe 가입이 막혀 09-23 이 길로 켰다. 코드 변경 없음, SDK 가 env 를 읽는다):
#   TYPESAFE_API_KEY=<Vercel AI Gateway 키>
#   TYPESAFE_BASE_URL=https://ai-gateway.vercel.sh/typesafe
#   TYPESAFE_DEFAULT_MODEL=typesafe-ai/jev
# CLOUDFLARE_ACCOUNT_ID=<...>   # 32자리. Workers AI 페이지에 있다. Jev 는 무료 Neurons 가 아니라 AI Gateway 선불 잔액에서 빠진다
# CLOUDFLARE_API_TOKEN=<...>    # Workers AI Read·Edit 권한 토큰

# ── Langfuse (필수 조건 4: 트레이싱·평가) ──────────────
# LANGFUSE_PUBLIC_KEY=<...>
# LANGFUSE_SECRET_KEY=<...>
# LANGFUSE_HOST=https://cloud.langfuse.com   # Langfuse Cloud. 자체 호스팅이면 그 주소 (SDD 9절)

# ── DB ──────────────────────────────────────────────
# 로컬은 아래 값 그대로(compose의 db 컨테이너). 운영은 Supabase 대시보드 > Connect의 연결 문자열.
# 주석으로 두면 api 가 기동 시 KeyError: 'DATABASE_URL' 로 죽는다 (10-09 새 clone 에서 확인)
DATABASE_URL=postgresql://app:app@db:5432/app

# ── 로그인 (Supabase Auth) ───────────────────────────
# 백엔드가 액세스 토큰의 서명을 Supabase 공개키(jwks.json)로 검증할 때 씀. 비밀값 아님.
# SUPABASE_URL=https://<project-ref>.supabase.co
# AUTH_REQUIRED=true           # 로컬 채점용으로만 false. 배포 환경에서는 항상 true
# 프론트가 쓰는 PUBLISHABLE_KEY는 frontend/.env.example에.

# ── 프론트 허용 주소 (CORS) ──────────────────────────
# 브라우저가 이 API를 부를 수 있는 프론트 주소. 로컬 기본값. 배포 후 Vercel 주소를 쉼표로 추가.
# FRONTEND_ORIGIN=http://localhost:3000

# ── 보안·내부 ────────────────────────────────────────
# ENCRYPTION_KEY=<...>          # 32바이트 base64, AES-256-GCM
# MCP_TOKEN=<...>                 # /mcp Bearer 토큰. 백엔드와 MCP 클라이언트만 쓴다
# MCP_PUBLIC_URL=http://localhost:8000/mcp   # /mcp 공개 주소. 배포는 Cloud Run 주소 + /mcp
# INTERNAL_TOKEN=<...>          # /internal/cleanup
